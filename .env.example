# Required for api/get-involved.ts and api/rsvp.ts to send email via Resend.
# Set this in Vercel Project Settings > Environment Variables (do not commit the real value).
RESEND_API_KEY=

# Required for api/books.ts and api/events.ts to read the Google Sheet catalog.
# The sheet ID is the long id in its URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# The sheet must be shared as "Anyone with the link" -> Viewer.
GOOGLE_SHEET_ID=

# Each tab's gid is in the URL when that tab is selected, e.g. ...#gid=123456789
# Defaults to "0" (the first/leftmost tab) if not set.
GOOGLE_SHEET_BOOKS_GID=
GOOGLE_SHEET_EVENTS_GID=

# Required for api/rsvp.ts to increment an event's Registered count in the sheet.
# The Web app URL from deploying the Apps Script's doPost (see README "RSVP sheet
# updates" section) — ends in /exec. SHEET_RSVP_SECRET must match the RSVP_SECRET
# Script Property set on that same Apps Script project.
GOOGLE_APPS_SCRIPT_RSVP_URL=
SHEET_RSVP_SECRET=
